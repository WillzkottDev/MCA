{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mca",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mca-directorio",
      "database_id": "9f6276fa-516e-4e01-b629-afaa65a31520"
    }
  ]
}
